# EVA Speak runtime configuration

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/eva-speak?retryWrites=true&w=majority

# ── Google OAuth 2.0 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
JWT_SECRET=change-this-to-a-random-32-char-secret

# ── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI / RAG Pipeline ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=eva-speak-resumes

# ── Speech Analysis ─────────────────────────────────────────
EVA_MODEL_SIZE=tiny.en
EVA_DEFAULT_EXPECTED_TEXT=The quick brown fox jumps over the lazy dog.
EVA_MAX_EXPECTED_TEXT_CHARACTERS=5000
EVA_WHISPER_BEAM_SIZE=5
EVA_WHISPER_VAD_FILTER=true

# ── Vision Analysis ─────────────────────────────────────────
EVA_VISION_SAMPLE_FPS=2.0
EVA_VISION_MAX_WIDTH=960
EVA_VISION_REFINE_LANDMARKS=true

# ── Server ───────────────────────────────────────────────────
PORT=3001
VITE_API_BASE_URL=http://localhost:3001
EVA_ALLOWED_ORIGINS=http://localhost:5173,https://eva-speak.vercel.app
EVA_ANALYSIS_TIMEOUT_MS=300000

# ── Hugging Face (for whisper model download) ───────────────
HF_TOKEN=your_hugging_face_token
